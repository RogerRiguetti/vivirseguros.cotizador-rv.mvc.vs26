    <add name="VCEConection" connectionString="RGF0YSBTb3VyY2U9MTUwLjEwMC4xMC4xMDE7IEluaXRpYWwgQ2F0YWxvZz1WQ0VzdHVkaW9PZmljaWFsZXM7dWlkPWNvdGl6YWRvcjtwd2Q9VmlkYWNhbWFyYTEyMzQ=" />
    <add name="SRVConection" connectionString="RGF0YSBTb3VyY2U9MTkyLjE2OC4wLjE0OTsgSW5pdGlhbCBDYXRhbG9nPVNlZ3Vyb1JWO3VpZD1zYTtwd2Q9RWlzZWlfZGdvOyA=" />
  </connectionStrings>-->
  <!--- conexion Servidor contingencia-->
  <!---<connectionStrings>
    <add name="VCEConection" connectionString="RGF0YSBTb3VyY2U9MTUwLjEwMC4xMC4xMDE7IEluaXRpYWwgQ2F0YWxvZz1WQ0VzdHVkaW9fQks7dWlkPWNvdGl6YWRvcjtwd2Q9VmlkYWNhbWFyYTEyMzQ=" />
