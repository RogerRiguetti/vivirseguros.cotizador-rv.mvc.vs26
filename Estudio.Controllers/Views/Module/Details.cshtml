@model Estudio.Repository.Core.Domain.gzModule
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    //For SelectFx
    //SelectListItem _defaultSystem =
    //    new SelectListItem { Text = "Systems...", Value = "", Disabled = true, Selected = false };

    string textSystem = new Estudio.Controllers.Models.SystemModel().Search("", "").Find(o => o.Id == Model.SystemId).Description;
}


<form id="myform">
    <div id="wrapper">
        <div id="page-wrapper">
            <div class="row">
                <div class="col-xs-12">
                    <h1 class="page-header">Modules</h1>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12">
                    <div class="row">
                        <div class="col-xs-6 text-left">
                            <span class="input">
                                <input id='txtDescription' disabled="disabled" class='input_field' type="text" name="txtDescription" value="@Model.Description" />
                                <label for='txtDescription'>
                                    <span>Description</span>
                                </label>
                            </span>
                        </div>
                        <div class="col-xs-6 text-left">
                            <span class="input">
                                <input id='txtSystem' disabled="disabled" class='input_field' type="text" name="txtSystem" value="@textSystem" />
                                <label for='txtSystem'>
                                    <span>System</span>
                                </label>
                            </span>

                        </div>

                    </div>

                    <div class="row" style="height:60px;"></div>
                    <div class="row">
                        <div class="col-xs-6 text-left">
                            <a class="btn btn-default" href="@Url.Action("Index", "Module")">Return <span class="glyphicon glyphicon-arrow-left"></span></a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@Html.Hidden("url", Url.Action("Details", "Module"))


@section scriptsFooter
{
    <script src="~/Resources/js/jsModuleSave.js"></script>
    <script src="https://cdn.jsdelivr.net/jquery.validation/1.15.0/additional-methods.min.js"></script>

}




