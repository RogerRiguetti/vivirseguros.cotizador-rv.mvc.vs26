@model Estudio.Repository.Core.Domain.UserProfile
@{
    ViewBag.Title = "Índice";
    ViewBag.Header = "Mantenedor de Perfiles";

    Layout = "~/Views/Shared/_Layout.cshtml";

    int userId = Convert.ToInt32(this.Session["UserId"].ToString());
    var res = new Estudio.Controllers.Controllers.UserController().GetPermissions(userId);
    Estudio.Logic.Identity identity = new Estudio.Logic.Identity();
    identity = (Estudio.Logic.Identity)res.Object;

    System.Globalization.CultureInfo ciCurr = System.Globalization.CultureInfo.CurrentCulture;

    List<SelectListItem> listSistemas = new List<SelectListItem>();
    listSistemas.AddRange(new SelectList(new Estudio.Controllers.Controllers.MantenedorPerfilesController().ObtenerSistemas(), "IdSistema", "NombreSistema"));

    List<SelectListItem> listRole = new List<SelectListItem>();
    listRole.AddRange(new SelectList(new Estudio.Controllers.Controllers.MantenedorPerfilesController().ObtenerRoles(), "UserId", "Name"));


}

<style>
    .resaltar {
        background-color: yellow;
        color: black;
    }

    .comboMultiple > button {
        BORDER: 1px solid #ccc !important;
        BACKGROUND: WHITE !important;
        color: #555555 !important;
    }
</style>
<div class="panel panel-default">
    <div class="panel-heading">
        Búsqueda
    </div>
    <div class="panel-body">
        <div class="form-group col-lg-3 col-md-4 col-sm-6">
            <label class="form-label" for="txtSistema">Sistema</label>
            @Html.DropDownList("cmbxSistemas", listSistemas, "Todos", new { @class = "form-control" })
        </div>
        <div class="form-group col-lg-3 col-md-4 col-sm-6">
            <label class="form-label" for='txtUserProfile'>Rol</label>
            <select id="cmbxRolesDetails" name="cmbxRolesDetails" style="width: 85%;" multiple data-style="bg-white rounded-pill px-4 py-3 shadow-sm "
                    class="form-control selectpicker w-100  comboMultiple " data-none-selected-text="Selecione los Roles">
            </select>
        </div>
        <div class="form-group col-lg-3 col-md-4 col-sm-6">
            <label class="form-label" for="BusquedaPermiso">Clave del Permiso</label>
            <input type="text" class="form-control" name="BusquedaPermiso" id="BusquedaPermiso" maxlength="30">
        </div>



        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <a class="btn btnLight btn-md" id="btnSearch">Buscar <span class="fa fa-search"></span></a>
            <a class="btn btnDark btn-md" id="btnAdd" href="@Url.Action("Create", "MantenedorPerfiles")">Agregar <span class="fa fa-plus"></span></a>
        </div>

    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading">Resultados</div>
    <div class="panel-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover display" id="tblCatalog" style="width:100%">
                <thead>
                    <tr>
                        <th style="width:20px; " !important>Nombre de la Pantalla</th>
                        <th style="width:20px; " !important>Nodo Padre</th>
                        <th style="width:20px; " !important>Clave del Permiso</th>
                        <th style="width:20px;" !important>Estado</th>
                        <th style="width:20px;" !important>Sistema</th>

                        @foreach (var item in listRole)
                        {
                            <th style="width:20px;" !important id="@item.Value" name="@item.Value">@item.Text</th>

                        }
                        <th style="width:20px;" !important>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>

        <div class="row col-lg-6 col-md-6 col-sm-6 col-xs-12">
            <div class="col-lg-3 col-md-4 col-sm-6 col-xs-6 text-left">
                <a class="btn btn-vida btn-md" id="btnSave">Guardar <span class="fa fa-save fa-lg"></span></a>
            </div>
        </div>
    </div>
</div>



@* Begins Hiddens *@
@Html.Hidden("modal_delete_header", (object)ViewBag.modal_delete_header)
@Html.Hidden("modal_delete_body", (object)ViewBag.modal_delete_body)
@Html.Hidden("urlConsultarRoles", Url.Action("ConsultarRoles", "MantenedorPerfiles"))
@Html.Hidden("RedirectToCreate", Url.Action("Create", "MantenedorPerfiles"))
@Html.Hidden("UrlSearch", Url.Action("Search", "MantenedorPerfiles"))
@Html.Hidden("UrlUpdatePermiso", Url.Action("UpdatePermiso", "MantenedorPerfiles"))

@if (identity.MantenedorPerfilesEdit)
{
    @Html.Hidden("RedirectToEdit", Url.Action("Edit", "MantenedorPerfiles"))
}
@if (identity.MantenedorPerfilesDelete)
{
    @Html.Hidden("urlDelete", Url.Action("Delete", "MantenedorPerfiles"))
}
@if (identity.MantenedorPerfilesDetails)
{
    @Html.Hidden("RedirectToDetails", Url.Action("Details", "MantenedorPerfiles"))
}


@section scriptsFooter
{
    <link href="~/Content/bootstrap-multiselect.css" rel="stylesheet" />
    <script src="~/Scripts/bootstrap-multiselect.min.js"></script>
    <script src="~/Resources/js/jquery.dataTables.min.js"></script>
    <script src="~/Resources/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Resources/js/dataTables.responsive.js"></script>
    <script src="~/Resources/js/jsMantenedorPerfiles.js"></script>
    <script src="~/Resources/js/dataTables.fixedColumns.min.js"></script>
    
}




