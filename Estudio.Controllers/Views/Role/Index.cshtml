
@{
    ViewBag.Title = "Índice";
    ViewBag.Header = "Roles";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int userId = Convert.ToInt32(this.Session["UserId"].ToString());
    var res = new Estudio.Controllers.Controllers.UserController().GetPermissions(userId);
    Estudio.Logic.Identity identity = new Estudio.Logic.Identity();
    identity = (Estudio.Logic.Identity)res.Object;
}

    <div class="panel panel-default">
        <div class="panel-body">
            <div class="col-lg-12 col-md-12 col-sm-12" style="margin-bottom: 10px;">
                <a class="btn btnDark" id="btnAdd" href="@Url.Action("Create", "Role")">Agregar <span class="fa fa-plus"></span></a>
            </div>
            <div class="clearfix"></div>
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover" id="tblCatalog" style="width: 100%">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Clave</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th>AccionesAcciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in new Estudio.Controllers.Controllers.RoleController().Search())
                        {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Clave</td>
                            <td>@item.Description</td>
                            <td>@item.Status</td>
                            <td>
                                <div class='row'>
                                    @if (identity.RoleDetails)
                                    {
                                        <div class='col-xs-3'><a href="javascript:Details('@item.Id');" title='Detalles'><i class='fa fa-search fa-lg icon-vida'></i></a></div>
                                    }
                                    else
                                    {
                                        <div class='col-xs-3'><a href="#" disabled="true" title='No cuenta con los permisos necesarios'><i class='fa fa-ban fa-lg icon-vida'></i></a></div>
                                    }
                                    @if (identity.RoleEdit)
                                    {
                                        <div class='col-xs-3'><a href="javascript:Edit('@item.Id');" title='Editar'><i class='fa fa-edit fa-lg icon-vida'></i></a></div>
                                    }
                                    else
                                    {
                                        <div class='col-xs-3'><a href="#" disabled="true" title='No cuenta con los permisos necesarios'><i class='fa fa-ban fa-lg icon-vida'></i></a></div>
                                    }
                                    @if (identity.RoleDelete)
                                    {
                                        if (@item.Status == "Activo")
                                        {
                                            <div class='col-xs-3'><a href="javascript:Delete('@item.Id','0');" title='Desactivar'><i class='fa fa-remove fa-lg icon-vida'></i></a></div>
                                        }
                                        else
                                        {
                                            <div class='col-xs-3'><a href="javascript:Delete('@item.Id','1');" title='Activar'><i class='fa fa-check fa-lg icon-vida'></i></a></div>
                                        }
                                    }
                                    else
                                    {
                                        <div class='col-xs-3'><a href="#" disabled="true" title='No cuenta con los permisos necesarios'><i class='fa fa-ban fa-lg icon-vida'></i></a></div>
                                    }


                                </div>
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>


@* Begin Mensajes del sistema *@
<input id="modal_delete_role" type="text" value="@Estudio.Controllers.Assets.Utils.modal_deleterole_Text" style="display:none;" />
<input id="modal_delete_header" type="text" value="@ViewBag.modal_delete_header" style="display:none;" />
<input id="modal_delete_body" type="text" value="@ViewBag.modal_delete_body" style="display:none;" />
<input id="url" type="text" value="@Url.Action("Delete", "Role")" style="display:none;" />
@Html.Hidden("RedirectToConfigure", Url.Action("Configure", "Role"))
@Html.Hidden("RedirectToDetails", Url.Action("Details", "Role"))
@Html.Hidden("RedirectToDelete", Url.Action("Delete", "Role"))
@Html.Hidden("RedirectToEdit", Url.Action("Edit", "Role"))
@Html.Hidden("RedirectToCreate", Url.Action("Create", "Role"))
@Html.Hidden("UrlSearch", Url.Action("Search", "Role"))

<div id="sch_alert" class="sch_alert hidden " role="alert">
    <button id="sch_alert_close" type="button" class="close"><i class="fa fa-close"></i></button>
    <div id="sch_alert_message"></div>
</div>

@* End Mensajes del sistema *@

@section scriptsFooter
{
    <script src="~/Resources/js/jquery.dataTables.min.js"></script>
    <script src="~/Resources/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Resources/js/dataTables.responsive.js"></script>
    <script src="~/Resources/js/jsRole.js"></script>
}





