</form>

@*ModalCargar*@
<div class="modal fade" id="modalcargar" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Procesando validaciones</h4>
            </div>
            <div class="modal-body" style="text-align:center">
                <p class="txt-modal">Espere un momento</p>
                <img src="~/Resources/img/spinner.gif" />
            </div>

        </div>
    </div>
</div>

@* Begins Hiddens *@
@Html.Hidden("urlCalculadas", Url.Action("ListaCalculadas", "SolicitudCotizacion"))
@Html.Hidden("urlNoCalculadas", Url.Action("ListaNoCalculadas", "SolicitudCotizacion"))
@Html.Hidden("urlRptCalculadas", Url.Action("RptCalculadas", "SolicitudCotizacion"))
@Html.Hidden("urlRptNoCalculadas", Url.Action("RptNoCalculadas", "SolicitudCotizacion"))
@Html.Hidden("urlcrearXML", Url.Action("crearXML", "SolicitudCotizacion"))
@Html.Hidden("urlCrearExcel", Url.Action("ExportarCalculadas", "SolicitudCotizacion"))
@*@Html.ActionLink("Click here to download", "ExportarCalculadas", new { })*@

@Html.Hidden("urlcrearXMLB", Url.Action("crearXMLB", "SolicitudCotizacion"))





@section scriptsFooter
{
    <script src="~/Resources/js/jquery.dataTables.min.js"></script>
    <script src="~/Resources/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Resources/js/dataTables.responsive.js"></script>
    <script src="~/Resources/js/jsCalculoCotizacion.js"></script>

}


