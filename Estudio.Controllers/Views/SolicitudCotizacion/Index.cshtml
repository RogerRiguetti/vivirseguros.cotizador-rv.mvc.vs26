
@{
    ViewBag.Title = "Solicitud Cotización";
    ViewBag.Header = "Carga de Archivo - Solicitud de Cotización";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    @@media (min-width:885px) and (max-width: 1080px) {
        .page-header {
            font-size: 2em !important;
        }

        .btnCargarDIV {
            top: 0px !important;
        }
    }

    @@media (max-width: 884px) {
        .page-header {
            font-size: 1.6em !important;
        }
    }

      .modalcargar {
        position: fixed;
        left: 0px;
        top: 0px;
        width: 100%;
        height: 100%;
        z-index: 9999;
        background: 50% 50% no-repeat rgb(249,249,249);
        opacity: .8;
    }

    .ImgModal{
        margin-left: 40%;
        margin-top: 15%;
    }
    @@media (max-width: 820px) {
        .page-header {
            font-size: 2em !important;
        }
    }
</style>

<form id="myform">

    <div class="panel panel-default">
        <div class="panel-heading">
            Seleccionar archivo a cargar
        </div>
        <div class="panel-body">
            <form id="form-file" method="post" enctype="multipart/form-data">
                @*Input donde se mostrara el nombre del xml*@
                <div class="form-group col-lg-5">
                    <label for="txtArchivoCargado" class="form-label">Archivo</label>
                    <input type="text" class="form-control" name="txtArchivoCargado" id="txtArchivoCargado" disabled>
                </div>

                @*Parte del boton para cargar el archivo*@
                <div class="form-group col-lg-3" style="margin-top: 25px;">
                    <label for="file-input" name="__labelInput" class="btn btn-default btnDark"><i class="fa fa-search" aria-hidden="true"></i> Buscar Archivo</label>
                    <input id="file-input" name="__fileInput" type="file" accept=".xml" style="display:none;" validateRequest="false" onchange="return cambiarFile();" valid />
                </div>

            </form>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading">
            Datos del Archivo
        </div>
        <div class="panel-body">
            @*Carga el nombre del archivo*@
            <div class="form-group col-lg-3 col-md-4 col-sm-6">
                <label for="txtNombreArchivo" class="form-label">Nombre del Archivo</label>
                <input type="text" class="form-control" name="txtNombreArchivo" id="txtNombreArchivo" value="" disabled>
            </div>

            @*Carga el tipo de archivo*@
            <div class="form-group col-lg-3 col-md-4 col-sm-6">
                <label for="txtTipoArchivo" class="form-label">Tipo de Archivo</label>
                <input type="text" class="form-control" name="txtTipoArchivo" id="txtTipoArchivo" value="" disabled>
            </div>

            @*Carga el usuario*@
            <div class="form-group col-lg-3 col-md-4 col-sm-6">
                <label for="txtUsuario" class="form-label">Usuario</label>
                <input type="text" class="form-control" name="txtUsuario" id="txtUsuario" value="" disabled>
            </div>
            <div class="clearfix"></div>
            @*Fecha de carga*@
            <div class="form-group col-lg-3 col-md-4 col-sm-6">
                <label for="txtFechaCarga" class="form-label">Fecha de Carga</label>
                <input type="text" class="form-control" name="txtFechaCarga" id="txtFechaCarga" value="" disabled>
            </div>

            @*Hora de carga*@
            <div class="form-group col-lg-3 col-md-4 col-sm-6">
                <label for="txtHoraCarga" class="form-label">Hora de Carga</label>
                <input type="text" class="form-control" name="txtHoraCarga" id="txtHoraCarga" value="" disabled>
            </div>

            <div class="col-sm-12 col-md-12 col-lg-12 col-xs-12 btnCargarDIV" style="text-align: right">
                <button type="button" id="btnCargaSol" name="btnCargaSol" class="btn btn-default btnDark" onclick="cargarsolicitudes();"><i class="fa fa-folder-open-o fa-lg" aria-hidden="true"></i> Cargar</button>
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading">
            Resultados
        </div>
        <div class="panel-body">
            @*Totales de solicitudes*@
            <div class="form-group col-lg-4 col-md-4 col-sm-6">
                <label for="txtSolicitudesT" class="form-label">Número de Solicitudes Totales</label>
                <input type="text" class="form-control" name="txtSolicitudesT" id="txtSolicitudesT" value="" disabled>
            </div>

            @*Solicitudes correctas*@
            <div class="form-group col-lg-4 col-md-4 col-sm-6">
                <label for="txtSolicitudesC" class="form-label">Número de Solicitudes Correctas</label>
                <input type="text" class="form-control" name="txtSolicitudesC" id="txtSolicitudesC" value="" disabled>
            </div>

            @*Solicitudes erroneas*@
            <div class="form-group col-lg-4 col-md-4 col-sm-6">
                <label for="txtSolicitudesE" class="form-label">Número de Solicitudes Erróneas</label>
                <input type="text" class="form-control" name="txtSolicitudesE" id="txtSolicitudesE" value="" disabled>
            </div>

        </div>
    </div>

    @*Iconos de opciones*@
    <div class="btn-group" style="float: right">
        <button type="button" id="btnImprimirResumen" name="btnImprimirResumen" class="btn btn-default btnDark" onclick="imprimirResumen();" style="margin-right: 20px"><i class="fa fa-print fa-lg" aria-hidden="true"></i> Resumen</button>
        <button type="button" id="btnImprimirErrores" name="btnImprimirErrores" class="btn btn-default btnLight" onclick="imprimirErrores();" style="margin-right: 20px"><i class="fa fa-exclamation-triangle fa-lg" aria-hidden="true"></i> Errores</button>
        <button type="button" id="btnSiguiente" name="btnSiguiente" class="btn btn-default btnGreen" onclick="siguiente();" style="margin-right: 20px"><i class="fa fa-arrow-right fa-lg" aria-hidden="true"></i> Siguiente</button>
    </div>
</form>

<div class="modal fade" id="modalcargar" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Procesando validaciones</h4>
            </div>
            <div class="modal-body" style="text-align:center">
                <p class="txt-modal">Espere un momento</p>
                <img src="~/Resources/img/spinner.gif" />
            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="cargaArchivo" role="dialog" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Cargando avance</h4>
            </div>
            <div class="modal-body">
                <div class="bar" style="display:none">
                    <p id="porcentaje" class="txt-modal">%</p>
                    <div class="progress">
                        <div class="progress-bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@* Begins Hiddens *@
@Html.Hidden("urlCargarXML", Url.Action("cargarXML", "SolicitudCotizacion"))
@Html.Hidden("urlUsuario", (object)ViewBag.usuario)
@Html.Hidden("urlAsignacionIntermediario", Url.Action("AsignacionIntermediario", "SolicitudCotizacion"))
@Html.Hidden("urlSiguiente", Url.Action("AsignacionIntermediario", "SolicitudCotizacion"))
@Html.Hidden("urlDatosSiguiente", Url.Action("datosSiguiente", "SolicitudCotizacion"))
@Html.Hidden("urlRptErrores", Url.Action("Reporte_De_Errores_En_La_Carga", "SolicitudCotizacion"))
@Html.Hidden("urlRptResumen", Url.Action("Reporte_De_Resumen_De_Carga", "SolicitudCotizacion"))
@section scriptsFooter
{
    <script src="~/Resources/js/jquery.dataTables.min.js"></script>
    <script src="~/Resources/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Resources/js/dataTables.responsive.js"></script>
    @*<link href="//netdna.bootstrapcdn.com/bootstrap/3.2.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">*@
    <script src="http://malsup.github.com/jquery.form.js"></script>
    <script src="~/Resources/js/jsSolicitudCotizacion.js"></script>

}