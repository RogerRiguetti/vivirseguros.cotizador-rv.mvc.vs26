
@{
    ViewBag.Header = "Mantenimiento de Curvas de Tasas de Reservas";
    ViewBag.Title = "Mantenimiento de Curvas de Tasas de Reservas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    @@media(max-width: 565px) {
        .page-header {
            font-size: 2em !important;
        }
    }

    input[type="checkbox"] {
        display: none;
    }

        input[type="checkbox"] + label span {
            display: inline-block;
            width: 17px;
            height: 17px;
            margin: -1px 4px 0 0;
            vertical-align: middle;
            background: url(/Resources/img/iconos/check.png) center no-repeat;
            cursor: pointer;
        }

        input[type="checkbox"]:checked + label span {
            background: url(/Resources/img/iconos/cheked.png) center no-repeat;
        }

    .modalcargar {
        position: fixed;
        left: 0px;
        top: 0px;
        width: 100%;
        height: 100%;
        z-index: 9999;
        background: 50% 50% no-repeat rgb(249,249,249);
        opacity: .8;
    }

    .ImgModal {
        margin-left: 40%;
        margin-top: 10%;
    }
</style>

<div class="panel panel-default">
    <div class="panel-body">
        @*Nueva Curva de Tasas*@
        @using (Html.BeginForm("UploadFile", "ManCurvaTasasRes", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
    @Html.AntiForgeryToken() // si tienes el decorador [ValidateAntiForgeryToken] en tu accion del controlador
    <div class="form-group col-lg-4 col-md-6 col-sm-6">
        <label class="form-label" for="txtArchivoCargado">Nueva Curva de Tasas</label>
        <input type="text" class="form-control" name="txtArchivoCargado" id="txtArchivoCargado" disabled>
    </div>
    <div class="col-lg-8 col-md-6 col-sm-6" style="margin-top: 25px;">
        @*Parte del boton para buscar el archivo*@
        <label for="file-input" name="__labelInput" class="btn btn-default btnLight"><i class="fa fa-search" aria-hidden="true"></i> Buscar Archivo</label>
        <input id="file-input" name="file" type="file" accept=".xls, .xlsx" style="display:none;" validateRequest="false" onchange="return cambiarFile();" valid />
        @*Parte del boton para cargar el archivo*@
        <label for="file-submit" name="__labelsubmit" class="btn btn-default btnDark"><i class="fa fa-folder-open-o fa-lg" aria-hidden="true"></i> Cargar</label>
        <input id="file-submit" type="submit" style="display:none;" disabled onclick="return abrirModal();" />
    </div>
    }
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-body">
        @*Carga*@
        <div class="form-group col-lg-2 col-md-2 col-sm-3 col-xs-6">
            <label class="form-label" for="txtCarga">Carga</label>
            <input type="text" class="form-control" name="txtCarga" id="txtCarga" maxlength="7" placeholder="YYYYMM" onKeyUp="this.value = formateafechaYearMes(this.value);">
        </div>
        <div class="form-group col-sm-6 col-md-4 col-lg-4 col-xs-6" style="margin-top:25px">
            <button type="button" id="btnBuscar" name="btnBuscar" class="btn btn-default btnGreen" onclick="BuscarPorFecha();"><i class="fa fa-search fa-lg" aria-hidden="true"></i> Buscar</button>
        </div>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover" id="tblConsultaMantenimientoCurvaTasas" style="width:100%">
                <thead>
                    <tr>
                        <th></th>
                        <th>Soles Ix</th>
                        <th>Soles Aj</th>
                        <th>Dolares Aj</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@*ModalCargar*@
<div class="modal fade" id="modalcargar" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Procesando</h4>
            </div>
            <div class="modal-body" style="text-align:center">
                <p class="txt-modal">Espere un momento</p>
                <img src="~/Resources/img/spinner.gif" />
            </div>

        </div>
    </div>
</div>

        @* Begins Hiddens *@
        @Html.Hidden("urlSalir", Url.Action("Index", "Estudio"))
        @Html.Hidden("urlCargar", Url.Action("CargaTabla", "ManCurvaTasasRes"))
        @Html.Hidden("urlMensaje", (object)ViewBag.mensaje)

        @section scriptsFooter
{
            <script src="~/Resources/js/jquery.dataTables.min.js"></script>
            <script src="~/Resources/js/jsManCurvaTasasRes.js"></script>
            <script src="~/Resources/js/dataTables.bootstrap.min.js"></script>
            <script src="~/Resources/js/dataTables.responsive.js"></script>
        }

