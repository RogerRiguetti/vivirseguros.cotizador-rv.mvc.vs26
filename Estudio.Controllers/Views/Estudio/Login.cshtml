    <div id='sch_modal' class='modal fade' tabindex='-1' role='dialog' onkeypress="pulsarmodal(event)">
        <div class='modal-dialog modal-sm' role='document'>
            <div class="modal-content">
                <div class="modal-header">
                    <span id="msg_modal_header"></span>
                </div>
                <div class="modal-body">
                    <span id="msg_modal_body"></span>
                </div>
                <div class="modal-footer">
                    <button type="button" class='btn btn-vida' id="btn_modal_aceptar">Ok</button>
                    <button type="button" class="btn btn-danger" data-dismiss='modal' id="btn_modal_cerrar">Cancelar</button>
                </div>
            </div>
        </div>
    </div>

    <div id="sch_alert" class="sch_alert hidden " role="alert">
        <button id="sch_alert_close" type="button" class="close"><i class="fa fa-close"></i></button>
        <div id="sch_alert_message"></div>
    </div>

    @Html.Hidden("UrlIndex", Url.Action("Index", "Estudio"))
    @Html.Hidden("UrlValidateLogin", Url.Action("ValidateLogin", "Estudio"))

</body>

