<body style="padding:0;">
        <div class="header-login">
        <img src="~/Resources/img/logo_login.png" width="150" height="120"/>
    </div>
    <div class="container">
        <form id="myform">
            <div class="form-login col-lg-offset-4 col-lg-3 col-md-offset-4 col-md-4 col-sm-offset-3 col-sm-6 col-xs-offset-1 col-xs-10">
                <h4 class="titulo-login">Bienvenido</h4>
                <div class="form-group">
                    <input type="text" id="txtUser" name="txtUser" class="form-control" placeholder="Usuario" onkeyup="pulsar(event)" />
                </div>
                <br>
                <div class="form-group">
                    <input type="password" id="txtPassword" name="txtPassword" class="form-control" placeholder="Contraseña" onkeyup="pulsar(event)" />
                </div>
                <br>
                <a href="#" id="lnkEnter" class="btn btn-vida btn-md">Ingresar <i class="fa fa-sign-in"></i></a>
            </div>
        </form>
    </div>
