@{
    int userId = Convert.ToInt32(this.Session["UserId"].ToString());
    String userIdEncrypted = this.Session["UserIdEncrypted"].ToString();
    var res = new Estudio.Controllers.Controllers.UserController().GetPermissions(userId);

    Estudio.Logic.Identity identity = new Estudio.Logic.Identity();
    identity = (Estudio.Logic.Identity)res.Object;
    identity.UserId = this.Session["UserId"].ToString();
    identity.Account = this.Session["Account"].ToString();
    identity.Name = this.Session["Name"].ToString();
    string urlRentaPrivada = System.Configuration.ConfigurationManager.AppSettings["UrlRentaPrivada"] + userIdEncrypted;
    string urlEmision = System.Configuration.ConfigurationManager.AppSettings["UrlEmision"] + userIdEncrypted;
    string urlFondosMax = System.Configuration.ConfigurationManager.AppSettings["UrlFondosMax"] + userIdEncrypted;
    string urlGestorActivos = System.Configuration.ConfigurationManager.AppSettings["UrlGestorActivos"] + userIdEncrypted;
}

