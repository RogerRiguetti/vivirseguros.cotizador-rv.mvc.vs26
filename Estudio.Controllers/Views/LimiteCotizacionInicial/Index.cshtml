
@{
    ViewBag.Title = "Index";
    ViewBag.Header = "Mantenedor de Limites de Cotización Inicial";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .focus {
        background-color: beige !important;
        color: #000000;
        font-weight: bold;
        border-top: 2px solid #c9cad0;
        border-bottom: 2px solid #c9cad0;
    }

    @@media (max-width: 767px) {
        .btnBuscarDIV {
            margin-top: 10px !important;
        }
    }

    @@media(max-width: 767px) {
        .page-header {
            font-size: 1.5em !important;
        }
    }

    @@media(min-width: 768px) and (max-width: 1110px) {
        .page-header {
            font-size: 1.6em !important;
        }
    }
</style>

<div class="panel-group">
    <div class="panel panel-default">
        <div class="panel-heading">
            <label class="panel-title" style="font-size: 14px;">
                <a data-toggle="collapse" href="#contCargaMasiva">Carga masiva</a>
            </label>
        </div>
        <div id="contCargaMasiva" class="panel-collapse collapse">
            <div class="panel-body">
        @using (Html.BeginForm("UploadFile", "LimiteCotizacionInicial", FormMethod.Post, new { enctype = "multipart/form-data"}))
        {
        @Html.AntiForgeryToken() // si tienes el decorador [ValidateAntiForgeryToken] en tu accion del controlador
            <div class="form-group col-lg-4 col-md-2 col-sm-2">
                <label class="form-label" for="cmbxTipoRenta">Tipo Renta</label>
                <select id="cmbxTipoRenta" name="cmbxTipoRenta" class="form-control input-md" required>
                    <option value="">-- Seleccione --</option>
                    <option value="1">Inmediatas</option>
                    <option value="2">Diferidas</option>
                </select>
            </div>
            @*Input donde se mostrara el nombre del xml*@
            <div class="form-group col-lg-3 col-md-3 col-sm-4">
                <label class="form-label" for="txtArchivoCargado">Archivo</label>
                <input type="text" class="form-control" name="txtArchivoCargado" id="txtArchivoCargado" disabled>
            </div>
            <div class="col-lg-9 col-md-9 col-sm-8" style="margin-top: 25px;">
                @*Parte del boton para buscar el archivo*@
                <label for="file-input" name="__labelInput" class="btn btn-default btnLight"><i class="fa fa-search" aria-hidden="true"></i> Buscar</label>
                <input id="file-input" name="file" type="file" accept=".xls, .xlsx" style="display:none;" validateRequest="false" onchange="return cambiarFile();" valid />
                @*Parte del boton para cargar el archivo*@
                <label for="file-submit" name="__labelsubmit" class="btn btn-default btnDark"><i class="fa fa-folder-open-o fa-lg" aria-hidden="true"></i> Cargar</label>
                <input id="file-submit" type="submit" style="display:none;" disabled/>
            </div>
          }
            </div>
        </div>
    </div>
</div>
<div class="panel panel-default">
    <div class="panel-body">
        <div class="form-group col-lg-3 col-md-3 col-sm-4">
            <label class="form-label" for="cmbxDepartamentos">Departamento</label>
            @Html.DropDownList("cmbxDepartamentos", (IEnumerable<SelectListItem>)ViewBag.Departamentos, null, new { @class = "form-control", @name = "cmbxDepartamentos" })
        </div>
        <div class="form-group col-lg-3 col-md-3 col-sm-4">
            <label class="form-label" for="cmbxTipoMoneda">Tipo de Moneda</label>
            @Html.DropDownList("cmbxTipoMoneda", (IEnumerable<SelectListItem>)ViewBag.TipoMoneda, null, new { @class = "form-control", @style = " margin:  auto; ", @name = "cmbxTipoMoneda" })
        </div>
        <div class="form-group col-lg-3 col-md-3 col-sm-4">
            <label class="form-label" for="CmbxPeriodos">Periodos</label>
            @Html.DropDownList("CmbxPeriodos", (IEnumerable<SelectListItem>)ViewBag.Periodos, "-- Seleccione --", new { @class = "form-control", @style = " margin:  auto; ", @name = "CmbxPeriodos" })
        </div>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading">
        <label class="panel-title" style="font-size: 14px;">
            <a data-toggle="collapse" href="#vigencia">Período de Vigencia</a>
        </label>
    </div>
    <div id="vigencia" class="panel-collapse collapse">
        <div class="panel-body">
            <div class="form-group col-lg-3 col-md-3 col-sm-4">
                <label class="visible-xs form-label">Fecha Inicio</label>
                <Input type="date" class="form-control" name="fecIni" id="fecIni" value="@ViewBag.fecha" />
            </div>
            <div class="col-sm-1 col-md-1 col-lg-1 hidden-xs" style="text-align:center">
                <i class="fa fa-minus" aria-hidden="true"></i>
            </div>
            <div class="form-group col-lg-3 col-md-3 col-sm-4">
                <label class="visible-xs form-label">Fecha Fin</label>
                <Input type="date" class="form-control" name="fecFin" id="fecFin" value="@ViewBag.fecha" disabled />
            </div>
            <div class="form-group col-lg-3 col-md-3 col-sm-4">
                <button type="button" class="btn btn-default btnDark" id="btnBuscar" onclick="Buscar();"><i class="fa fa-search" aria-hidden="true"></i> Buscar</button>
                <button type="button" class="btn btn-default btnDark" id="btnBuscar2" style="display: none;"><i class="fa fa-search" aria-hidden="true"></i> Buscar</button>
            </div>
        </div>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-body">
        <ul class="nav nav-tabs" style="border-bottom:  none;" id="tabulador">
            <li class="disabled"><a data-toggle="tab" href="#tabTIR">TIR</a></li>
            <li class="disabled"><a data-toggle="tab" href="#tabPerdida">Pérdida</a></li>
            <li class="disabled"><a data-toggle="tab" href="#tabComision">Comisión</a></li>
            <li class="disabled"><a data-toggle="tab" href="#tabTV">TV</a></li>
        </ul>

        <div class="tab-content" style="display:  none" id="tabulador3">

            <div id="tabTIR" class="tab-pane fade in active">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        Rangos de TIR
                    </div>
                    <div class="panel-body">
                        <label class="form-label" for="txtMinTIR">Tasa Mínima Diferidas</label>
                        <div class="form-group col-lg-3 col-md-3 col-sm-4 input-group">
                            <input type="text" class="form-control" id="txtMinTIR" onkeyup="this.value = validaDecimales(this.value, 2);">
                            <span class="input-group-addon"><i class="fa fa-percent" aria-hidden="true"></i></span>
                        </div>
                    </div>
                    <div class="panel-body">
                        <label class="form-label" for="txtMinTIRInmediatas">Tasa Mínima Inmediatas</label>
                        <div class="form-group col-lg-3 col-md-3 col-sm-4 input-group">
                            <input type="text" class="form-control" id="txtMinTIRInmediatas" onkeyup="this.value = validaDecimales(this.value, 2);">
                            <span class="input-group-addon"><i class="fa fa-percent" aria-hidden="true"></i></span>
                        </div>
                    </div>
                </div>
            </div>

            <div id="tabPerdida" class="tab-pane fade">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        Rangos de Pérdida
                    </div>
                    <div class="panel-body">
                        <label class="form-label" for="txtMaxPer">Pérdida Máxima</label>
                        <div class="form-group col-lg-3 col-md-3 col-sm-4 input-group">
                            <input type="text" class="form-control" id="txtMaxPer" onkeyup="this.value = validaDecimales(this.value, 2);">
                            <span class="input-group-addon"><i class="fa fa-percent" aria-hidden="true"></i></span>
                        </div>
                    </div>
                </div>
            </div>

            <div id="tabComision" class="tab-pane fade">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        Rangos de comisión
                    </div>
                    <div class="panel-body">
                        <div class="row">
                            <div class="form-group col-lg-3 col-md-3 col-sm-4">
                                <label class="form-label" for="txtMinCom">Comisión Mínima</label>
                                <div class="form-group col-lg-12 col-md-12 col-sm-12 input-group">
                                    @*<div class="col-lg-11">*@
                                    <input type="text" class="form-control" id="txtMinCom" onkeyup="this.value = validaDecimales(this.value, 2);">
                                    @*</div>*@
                                    <span class="input-group-addon"><i class="fa fa-percent" aria-hidden="true"></i></span>
                                </div>
                            </div>
                            <div class="form-group col-lg-3 col-md-3 col-sm-4">
                                <label class="form-label" for="txtMinCom">Comisión Máxima</label>
                                <div class="form-group col-lg-12 col-md-12 col-sm-12 input-group">
                                    <input type="text" class="form-control" id="txtMaxCom" onkeyup="this.value = validaDecimales(this.value, 2);">
                                    <span class="input-group-addon"><i class="fa fa-percent" aria-hidden="true"></i></span>
                                </div>
                            </div>
                            <div class="form-group col-lg-3 col-md-3 col-sm-4">
                                <label class="form-label" for="txtMinCom">Comisión Inmediata</label>
                                <div class="form-group col-lg-12 col-md-12 col-sm-12 input-group">
                                    <input type="text" class="form-control" id="txtComInm" onkeyup="this.value = validaDecimales(this.value, 2);">
                                    <span class="input-group-addon"><i class="fa fa-percent" aria-hidden="true"></i></span>
                                </div>
                            </div>
                            <div class="form-group col-lg-3 col-md-3 col-sm-4">
                                <label class="form-label" for="txtMinCom">Comisión Diferida</label>
                                <div class="form-group col-lg-12 col-md-12 col-sm-12 input-group">
                                    <input type="text" class="form-control" id="txtComDif" onkeyup="this.value = validaDecimales(this.value, 2);">
                                    <span class="input-group-addon"><i class="fa fa-percent" aria-hidden="true"></i></span>
                                </div>
                            </div>
                        </div>
                            
                    </div>
                </div>
            </div>

            <div id="tabTV" class="tab-pane fade">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        Rangos de Tasa de Venta
                    </div>
                    <div class="panel-body">
                        <div class="form-group col-lg-3 col-md-3 col-sm-4">
                            <label class="form-label" for="cmbxRangoTasa">Pensión</label>
                            @Html.DropDownList("cmbxRangoTasa", (IEnumerable<SelectListItem>)ViewBag.RangoTasa, null, new { @class = "form-control", @style = " margin:  auto; ", @name = "cmbxRangoTasa" })
                        </div>

                        <label class="form-label" for="txtTV">Máxima</label>
                        <div class="form-group col-lg-3 col-md-3 col-sm-4 input-group">
                            <input type="text" class="form-control" id="txtTV" onkeyup="this.value = validaDecimales(this.value, 2);">
                            <span class="input-group-addon"><i class="fa fa-percent" aria-hidden="true"></i></span>
                        </div>
                        <div class="col-lg-8 col-md-6 col-sm-6">
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered table-hover dataTable no-footer" style="width: 100%;" id="tblTasaVenta">
                                    <thead>
                                        <tr id="fila0" onclick="seleccionar(this.id,'');">
                                            <th>Pensión</th>
                                            <th>Máximo</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>

                        <div class="btn-group col-lg-12">
                            <button type="button" class="btn btn-default btnDark" onclick="AgregarFila();" style="margin-right: 20px;"><i class="fa fa-plus fa-lg" aria-hidden="true"></i> Agregar</button>
                            <button type="button" class="btn btn-default btnLight" onclick="EliminarFila();" style="margin-right: 20px;"><i class="fa fa-trash-o fa-lg" aria-hidden="true"></i> Eliminar</button>
                            <button type="button" class="btn btn-default btnGreen" onclick="LimpiarFila();" style="margin-right: 20px;"><i class="fa fa-file-o fa-lg" aria-hidden="true"></i> Limpiar</button>
                        </div>   
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="btn-group" style="float: right">
    <button type="button" class="btn btn-default btnDark" onclick="Grabar();" style="margin-right: 20px;"><i class="fa fa-floppy-o fa-lg" aria-hidden="true"></i> Grabar</button>
    <button type="button" class="btn btn-default btnDark" onclick="Eliminar();" style="margin-right: 20px;"><i class="fa fa-trash-o fa-lg" aria-hidden="true"></i> Eliminar</button>
    <button type="button" class="btn btn-default btnDark" onclick="Imprimir();" style="margin-right: 20px;"><i class="fa fa-print fa-lg" aria-hidden="true"></i> Imprimir</button>
    <button type="button" class="btn btn-default btnLight" onclick="Limpiar();" style="margin-right: 20px;"><i class="fa fa-file-o fa-lg" aria-hidden="true"></i> Limpiar</button>
    <button type="button" class="btn btn-default btnGreen" onclick="Salir();" style="margin-right: 20px;"><img class="btnIcon" src="~/Resources/img/salir.png" /> Salir</button>
</div>

@* Begins Hiddens *@
@Html.Hidden("urlPeriodo", Url.Action("ListaPeriodos", "LimiteCotizacionInicial"))
@Html.Hidden("urlBuscar", Url.Action("Consulta", "LimiteCotizacionInicial"))
@Html.Hidden("vgMelerTirMax", "999.99")
@Html.Hidden("vgMelerPerConMin", "0.00")
@Html.Hidden("vgMelerTasaVtaMin", "0.00")
@Html.Hidden("urlGrabar", Url.Action("GrabarCorizacionInicial", "LimiteCotizacionInicial"))
@Html.Hidden("urlEliminar", Url.Action("EliminarCorizacionInicial", "LimiteCotizacionInicial"))
@Html.Hidden("urlReporte", Url.Action("Reporte", "LimiteCotizacionInicial"))
@Html.Hidden("urlCargaMasiva", Url.Action("UploadFile", "LimiteCotizacionInicial"))
@Html.Hidden("backFecha", (object)ViewBag.fecha)
@Html.Hidden("urlSalir", Url.Action("Index", "Estudio"))
@Html.Hidden("urlMensaje", (object)ViewBag.mensaje)
@section scriptsFooter
{
    <script src="~/Resources/js/jquery.dataTables.min.js"></script>
    <script src="~/Resources/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Resources/js/dataTables.responsive.js"></script>
    <script src="~/Resources/js/jsLimiteCotizacionInicial.js"></script>

}



