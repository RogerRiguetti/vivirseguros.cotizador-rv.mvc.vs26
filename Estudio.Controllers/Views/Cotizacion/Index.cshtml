
@{
    ViewBag.Title = "Consultar";
    ViewBag.Header = "Listado de Cotizaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";


    int userId = Convert.ToInt32(this.Session["UserId"].ToString());
    string rol = this.Session["Name"].ToString();
    int idTipoDocumento = Convert.ToInt32(this.Session["IdTipoDocumento"]);
    string documento = this.Session["Documento"] == null ? "" : this.Session["Documento"].ToString();
    string nombres = this.Session["Nombres"] == null ? "" : this.Session["Nombres"].ToString();
    string apellidos = this.Session["Apellidos"] == null ? "" : this.Session["Apellidos"].ToString();
    int asesor = Convert.ToInt32(this.Session["Asesor"]);
    string cuspp = this.Session["CUSPP"] == null ? "" : this.Session["CUSPP"].ToString();

    var res = new Estudio.Controllers.Controllers.UserController().GetPermissions(userId);
    Estudio.Logic.Identity identity = new Estudio.Logic.Identity();
    identity = (Estudio.Logic.Identity)res.Object;
    System.Globalization.CultureInfo ciCurr = System.Globalization.CultureInfo.CurrentCulture;

    if (rol == "Administrador")
    {
        @Html.Hidden("urlConsultaAdmin")
    }
}


