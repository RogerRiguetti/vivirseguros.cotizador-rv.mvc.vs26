<div class="panel panel-default">
    <div class="panel-heading">Resultados</div>
    <div class="panel-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover" id="tblConsultaCotizaciones" style="width:100%">
                <thead>
                    <tr>
                        <th>Número Cotización</th>
                        <th>Tipo documento</th>
                        <th>Número Documento</th>
                        <th>CUSPP</th>
                        <th>Nombres</th>
                        <th>Ape.Paterno</th>
                        <th>Ape.Materno</th>
                        <th>Fecha Cotiza</th>
                        <th>Asesor</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@* Begins Hiddens *@

@Html.Hidden("modal_delete_header", (object)ViewBag.modal_delete_header)
@Html.Hidden("modal_delete_body", (object)ViewBag.modal_delete_body)
@Html.Hidden("url", Url.Action("Search", "Cotizacion"))
@Html.Hidden("urlModificar", Url.Action("Edit", "Cotizacion"))
@Html.Hidden("urlClonar", Url.Action("Edit", "Cotizacion"))
@Html.Hidden("urlReporte", Url.Action("Reporte", "Cotizacion"))
@Html.Hidden("urlReporteT", Url.Action("ReporteTasa", "Cotizacion"))
@Html.Hidden("hdnGenerarReporte")
@Html.Hidden("UrlSearch", Url.Action("Search", "Cotizacion"))
@Html.Hidden("urlTipoDocumento", Url.Action("ValidaDocumento", "Cotizacion"))
@Html.Hidden("urlEliminaCoti", Url.Action("EliminaCotizacion", "Cotizacion"))

@if (identity.CotizacionEdit)
{
    @Html.Hidden("hdnModificar")
}

