    </div>*@

<div class="panel panel-default">
    <div class="panel-heading">
        Seleccionar archivo a cargar
    </div>
    <div class="panel-body">
        <div class="form-group col-lg-3 col-md-4 col-sm-6">
            <label class="form-label" for="cmbxTiposDocumento">Seleccione tipo de documento</label>
            @Html.DropDownList("cmbxTiposDocumento", (IEnumerable<SelectListItem>)ViewBag.TiposDocumento, "-- Seleccione --", new { @class = "form-control" })
        </div>
        <div class="form-group col-lg-3 col-md-4 col-sm-6">
            <label class="form-label" for="Buscar">Número de Documento</label>
            @Html.TextBox("Buscar", documento, new { @disabled = true, @class = "form-control", @name = "documento", @onkeyup = "return pulsar(event);", })
        </div>
        <div class="clearfix"></div>

        <div class="form-group col-lg-3 col-md-4 col-sm-6">
            <label class="form-label" for="BuscarN">Nombres</label>
            @Html.TextBox("BuscarN", nombres, new { @maxLenght = "50", @class = "form-control", @name = "BuscarN", @onkeypress = "return soloLetras(event);", @onkeyup = "return pulsar(event);", })
        </div>
        <div class="form-group col-lg-3 col-md-4 col-sm-6">
            <label class="form-label" for="BuscarAp">Apellidos</label>
            @Html.TextBox("BuscarAp", apellidos, new { @maxLenght = "60", @class = "form-control", @name = "BuscarAp", @onkeypress = "return soloLetras(event);", @onkeyup = "return pulsar(event);", })
        </div>
        <div class="clearfix"></div>

        <div class="form-group col-lg-3 col-md-4 col-sm-6">
            <label class="form-label" for="BuscarCuspp">CUSPP</label>
            @Html.TextBox("BuscarCuspp", cuspp, new { @maxLenght = "12", @class = "form-control", @name = "BuscarCuspp", @onkeyup = "return pulsar(event);", })
        </div>
        <div class="form-group col-lg-3 col-md-4 col-sm-6">
            <label class="form-label" for="cmbxAsesores">Seleccione Asesor</label>
            @if (rol == "Supervisor" || rol == "Administrador" || rol == "Gerente")
            {
                @Html.DropDownList("cmbxAsesores", null, "-- Seleccione --", new { @class = "form-control" })
            }
            else
            {
                @Html.DropDownList("cmbxAsesores", null, "-- Seleccione --", new { style = "display:none", @class = "form-control" })
            }
        </div>

        <div class="form-group col-lg-12 col-md-12 col-sm-12 col-xs-12" align="right">
            <a class="btn btn-vida btn-md" id="btnSearch" style="margin-right: 20px;"><i class="fa fa-search" aria-hidden="true"></i> Buscar</a>
            <a class="btn btn-vida btn-md" id="btnAdd" href="@Url.Action("Create", "Cotizacion")"><i class="fa fa-plus" aria-hidden="true"></i> Registrar</a>
        </div>

    </div>
</div>

