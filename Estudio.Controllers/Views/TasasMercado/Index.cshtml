@{
    ViewBag.Title = "Tasas de Mercado";
    ViewBag.Header = "Mantenedor de Tasas de Mercado Históricas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

</style>

<form id="myform">

    <div class="panel panel-default">
        <div class="panel-body">
            <div class="form-group col-xs-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px; margin: 0px;">
                <div class="col-md-3 col-lg-3" style="">
                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px;">
                        <label for="CmbxTipoMonedaTMH" class="form-label">Tipo de Moneda</label>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px;">
                        @Html.DropDownList("CmbxTipoMonedaTMH", (IEnumerable<SelectListItem>)ViewBag.TipoMoneda, "-- Seleccione --", new { @class = "form-control", @style = " margin:  auto; ", @name = "CmbxTipoMonedaTMH" })<br />
                    </div>
                </div>
                <div class="col-md-3 col-lg-3" style="">
                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px;">
                        <label for="CmbxTipoMonedaTMH" class="form-label">Año</label>
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px;">
                        @Html.DropDownList("cmbxYear", (IEnumerable<SelectListItem>)ViewBag.Year, "-- Seleccione --", new { @class = "form-control", @style = " margin:  auto; ", @name = "cmbxYear" })<br />
                    </div>
                </div>
                <div class="col-md-3 col-lg-3" style="">
                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px; height: 25px;"> </div>
                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px;">
                        <input type="text" class="form-control" id="txtYear" placeholder="Año" maxlength="4" style="margin:auto;" onkeypress="return soloNumeros(event);" /><br />
                    </div>
                </div>
                <div class="col-md-3 col-lg-3" style="">
                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px; height: 25px;"> </div>
                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px;">
                        <button type="button" class="btn btn-default btnDark" id="btnBuscar" onclick="Buscar();"><i class="fa fa-search" aria-hidden="true"></i> Buscar</button>
                    </div>
                </div>
            </div>
        </div>
    </div> <!--DIV QUE CIERRA PANEL - CAMPOS-->

    <div class="panel panel-default">
