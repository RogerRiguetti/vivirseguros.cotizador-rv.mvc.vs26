                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px;">
                        <input type="text" class="form-control" id="txtEneroTMH" placeholder="" maxlength="20" onkeyup="this.value = validaDecimales(this.value, 2);" /><br />
                    </div>
                </div>

                <div class="col-lg-3 col-md-4 col-sm-4 col-xs-6">
                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px;">
                        <label for="txtFebreroTMH" class="form-label">Febrero</label><br />
                    </div>
                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px;">
                        <input type="text" class="form-control" id="txtFebreroTMH" placeholder="" maxlength="20" onkeyup="this.value = validaDecimales(this.value, 2);" /><br />
                    </div>
                </div>

