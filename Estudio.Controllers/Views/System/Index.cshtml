
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int userId = Convert.ToInt32(this.Session["UserId"].ToString());
    var res = new Estudio.Controllers.Models.UserModel().GetPermissions(userId);
    Estudio.Controllers.Assets.Identity identity = new Estudio.Controllers.Assets.Identity();
    identity = (Estudio.Controllers.Assets.Identity)res.Object;

    System.Globalization.CultureInfo ciCurr = System.Globalization.CultureInfo.CurrentCulture;
}

<div id="wrapper">
    <div id="page-wrapper">
        <div class="row">
            <div class="col-xs-12">
                <h1 class="page-header">Systems</h1>
            </div>
        </div>
        <div class="row">
            <div class="col-xs-12">
                <div class="row">
                    <div class="col-xs-12 text-left">
                        <a class="btn btn-default" id="btnAdd" href="@Url.Action("Create", "System")">Add</span></a>
                    </div>
                </div>
                <div style="height:20px;"></div>
                <div class="panel panel-default">
                    <div class="panel-heading">Results</div>
                    <div class="panel-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered table-hover" id="tblCatalog">
                                <thead>
                                    <tr>
                                        <th style="width:20px">#</th>
                                        <th style="width:200px">Description</th>
                                        <th style="width:200px">Status</th>
                                        <th style="width:80px">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in new Estudio.Controllers.Models.SystemModel().Search("", ""))
                                    {
                                        <tr>
                                            <td>@item.Id</td>
                                            <td>@item.Description</td>
                                            <td>@item.Status</td>
                                            <td>
                                                <div class='row'>
                                                    @if (identity.SystemDetails)
                                                    {
                                                        <div class='col-xs-4'><a href="javascript:Details('@item.Id');"><i class='fa fa-search fa-lg'></i></a></div>
                                                    }
                                                    else
                                                    {
                                                        <div class='col-xs-4'><a href="#" disabled="true" title='You have not permission'><i class='fa fa-ban fa-lg'></i></a></div>
                                                    }
                                                    @if (identity.SystemEdit)
                                                    {
                                                        <div class='col-xs-4'><a href="javascript:Edit('@item.Id');"><i class='fa fa-edit fa-lg'></i></a></div>
                                                    }
                                                    else
                                                    {
                                                        <div class='col-xs-4'><a href="#" disabled="true" title='You have not permission'><i class='fa fa-ban fa-lg'></i></a></div>
                                                    }
                                                    @if (identity.SystemDelete)
                                                    {
                                                        <div class='col-xs-4'><a href="javascript:Delete('@item.Id');"><i class='fa fa-trash fa-lg'></i></a></div>
                                                    }
                                                    else
                                                    {
                                                        <div class='col-xs-4'><a href="#" disabled="true" title='You have not permission'><i class='fa fa-ban fa-lg'></i></a></div>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@* Begins Hiddens *@
@Html.Hidden("modal_delete_header", (object)ViewBag.modal_delete_header)
@Html.Hidden("modal_delete_body", (object)ViewBag.modal_delete_body)
@Html.Hidden("url", Url.Action("Delete", "System"))
@Html.Hidden("RedirectToDetails", Url.Action("Details", "System"))
@Html.Hidden("RedirectToDelete", Url.Action("Delete", "System"))
@Html.Hidden("RedirectToEdit", Url.Action("Edit", "System"))
@Html.Hidden("RedirectToCreate", Url.Action("Create", "System"))
@Html.Hidden("UrlSearch", Url.Action("Search", "System"))

@* End Hiddens *@




@section scriptsFooter
{
    <script src="~/Resources/js/jquery.dataTables.min.js"></script>
    <script src="~/Resources/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Resources/js/dataTables.responsive.js"></script>
    <script src="~/Resources/js/jsSystem.js"></script>
}





