
@{
    ViewBag.Title = "Excepciones";
    ViewBag.Header = "Excepciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .table-wrapper-scroll-y {
        display: block;
        max-height: 530px;
        overflow-y: auto;
        -ms-overflow-style: -ms-autohiding-scrollbar;
    }

    hr {
        margin-top: 0px !important;
        margin-bottom: 10px !important;
        border: 0;
        border-top: 2px solid #eee;
    }

    input[type="radio"] {
        display: none;
    }

        input[type="radio"] + label span {
            display: inline-block;
            width: 27px;
            height: 27px;
            margin: -1px 4px 0 0;
            vertical-align: middle;
            background: url(/Resources/img/iconos/check.png) center no-repeat;
            cursor: pointer;
        }

        input[type="radio"]:checked + label span {
            background: url(/Resources/img/iconos/cheked.png) center no-repeat;
        }

    @@media (max-width: 1513px) {
        .separador {
            height: 69px !important;
        }
    }

    .modalcargar {
        position: fixed;
        left: 0px;
        top: 0px;
        width: 100%;
        height: 100%;
        z-index: 9999;
        background: 50% 50% no-repeat rgb(249,249,249);
        opacity: .8;
    }

    .imgmod {
        margin-left: 40%;
        margin-top: 10%;
    }
</style>


<form id="myform">
    <div class="panel panel-default">
        <div class="panel-heading">
            Búsqueda
        </div>
        <div class="panel-body">
            @*Inputs para realizar la busqueda*@

            <div class="form-group col-lg-3">
                <label for="txtNumOperacion" class="form-label">N° Operación</label>
                <input type="text" class="form-control" name="txtNumOperacion" id="txtNumOperacion">
            </div>

            <div class="form-group col-lg-3">
                <label for="txtCUSPP" class="form-label">CUSPP</label>
                <input type="text" class="form-control" name="txtCUSPP" id="txtCUSPP" style="text-transform:uppercase;" maxlength="12">
            </div>

            <div class="form-group col-lg-1 col-md-1" style="margin-top:25px">
                <button type="button" class="btn btn-default btnDark" id="btnBuscar" onclick="busqueda();"><i class="fa fa-search" aria-hidden="true"></i> Buscar</button>
            </div>

        </div>
    </div><!--DIV QUE CIERRA PANEL-->

    <div class="panel panel-default">
        <div class="panel-heading">
            Datos
        </div>
        <div class="panel-body" id="caja">
            <div style="display:none;" id="datosDiv">
                <div class="form-group col-lg-4 col-md-6 col-sm-6" id="divOperacion">
                    <label class="form-label" for="txtNumOperacion2">N° Operación</label>
                    <input type="text" class="form-control" name="txtNumOperacion2" id="txtNumOperacion2">
                </div>

                <div class="form-group col-lg-4 col-md-6 col-sm-6" id="divCUSPP">
                    <label class="form-label" for="txtCUSPP2">CUSPP</label>
                    <input type="text" class="form-control" name="txtCUSPP2" id="txtCUSPP2">
                </div>

                <div class="form-group col-lg-4 col-md-6 col-sm-6" id="divPrestacion">
                    <label class="form-label" for="txtPrestacion">Prestación</label>
                    <input type="text" class="form-control" name="txtPrestacion" id="txtPrestacion" />
                </div>

                <div class="form-group col-lg-4 col-md-6 col-sm-6" id="divAsegurado">
                    <label class="form-label" for="txtAsegurado">Asegurado</label>
                    <input type="text" class="form-control" name="txtAsegurado" id="txtAsegurado">
                </div>

                <div class="form-group col-lg-4 col-md-6 col-sm-6" id="divDNI">
                    <label class="form-label" for="txtDNI">DNI</label>
                    <input type="text" class="form-control" name="txtDNI" id="txtDNI">
                </div>

                <div class="form-group col-lg-4 col-md-6 col-sm-6" id="divFec">
                    <label class="form-label" for="txtFecNac">Fecha de Nacimiento</label>
                    <input type="text" class="form-control" name="txtFecNac" id="txtFecNac">
                </div>

                <div class="form-group col-lg-4 col-md-6 col-sm-6" id="divSexo">
                    <label class="form-label" for="txtSexo">Sexo</label>
                    <input type="text" class="form-control" name="txtSexo" id="txtSexo">
                </div>

                <div class="form-group col-lg-4 col-md-6 col-sm-6" id="divDepartamentoMeler">
                    <label class="form-label" for="txtDepartamentoMeler">Departamento MELER</label>
                    <input type="text" class="form-control" name="txtDepartamentoMeler" id="txtDepartamentoMeler" />
                </div>

                <div class="form-group col-lg-4 col-md-6 col-sm-6" id="divFechaCierre">
                    <label class="form-label" for="txtFechaCierre">Fecha Cierre</label>
                    <input type="text" class="form-control" name="txtFechaCierre" id="txtFechaCierre" />
                </div>

                <div class="form-group col-lg-4 col-md-6 col-sm-6" id="divAFP">
                    <label class="form-label" for="txtAFP">AFP</label>
                    <input type="text" class="form-control" name="txtAFP" id="txtAFP">
                </div>
                <div class="form-group col-lg-4 col-md-6 col-sm-6" id="divCIC">
                    <label class="form-label" for="txtCIC">CIC</label>
                    <input type="text" class="form-control" name="txtCIC" id="txtCIC">
                </div>
                <div class="clearfix"></div>

                <div class="form-group col-lg-4 col-md-6 col-sm-6" id="divAsesor">
                    <label class="form-label" for="txtAsesor">Asesor</label>
                    <input type="text" class="form-control" name="txtAsesor" id="txtAsesor">
                </div>

                <div class="form-group col-lg-4 col-md-6 col-sm-6" id="divSupervisor">
                    <label class="form-label" for="txtSupervisor">Supervisor</label>
                    <input type="text" class="form-control" name="txtSupervisor" id="txtSupervisor" />
                </div>

                <div class="form-group col-lg-4 col-md-6 col-sm-6" id="divDepartamentoAsignado">
                    <label class="form-label" for="txtDepartamentoAsignado">Departamento Asignado</label>
                    <input type="text" class="form-control" name="txtDepartamentoAsignado" id="txtDepartamentoAsignado" />
                </div>
            </div>
        </div>
    </div><!--DIV QUE CIERRA PANEL-->

    <div class="panel panel-default">
        <div class="panel-body">
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover" id="tblConsulta" style="width:100%">
                    <thead>
                        <tr>
                            <th>Moneda</th>
                            <th>Modalidad</th>
                            <th>Periodo Diferido</th>
                            <th>% Renta Temporal</th>
                            <th>Periodo Garantizado</th>
                            <th>% Renta Escalonada</th>
                            <th>Prima Única</th>
                            <th>Renta Temporal/1er Tramo</th>
                            <th>Pension Vitalicia/2nd Tramo</th>
                            <th>Tasa de Venta</th>
                            <th>TIR</th>
                            <th>Perdida</th>
                            <th>Comisión</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="RConsultaBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-body">
            @*Nueva TV*@
            <div class="form-group col-lg-3 col-md-3 col-sm-6">
                <label class="form-label" for="txtNuevaTV">Nueva TV</label>
                <input type="text" class="form-control" name="txtNuevaTV" id="txtNuevaTV">
            </div>
            @*Nueva CO*@
            <div class="form-group col-lg-3 col-md-3 col-sm-6">
                <label class="form-label" for="txtNuevaCO">Nueva CO</label>
                <input type="text" class="form-control" name="txtNuevaCO" id="txtNuevaCO">
            </div>
            @*Parte del boton para calculo el archivo*@
            <div class="form-group col-sm-12 col-md-1 col-lg-1 col-xs-12" style="margin-top:25px">
                <button type="button" id="btnCalcular" name="btnCalcular" class="btn btn-default btnGreen" onclick="calcular();"><i class="fa fa-calculator fa-lg" aria-hidden="true"></i> Calcular</button>
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-body">
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover" id="tblCalculo" style="width:100%">
                    <thead>
                        <tr>
                            <th>Moneda</th>
                            <th>Modalidad</th>
                            <th>Periodo Diferido</th>
                            <th>% Renta Temporal</th>
                            <th>Periodo Garantizado</th>
                            <th>% Renta Escalonada</th>
                            <th>Prima Única</th>
                            <th>Renta Temporal/1er Tramo</th>
                            <th>Pension Vitalicia/2nd Tramo</th>
                            <th>Tasa de Venta</th>
                            <th>TIR</th>
                            <th>Perdida</th>
                            <th>Comisión</th>
                        </tr>
                    </thead>
                    <tbody id="RCalculoBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <div style="text-align: center">
        <button type="button" id="btnCargar" name="btnCargar" class="btn btn-default btnGreen" onclick="GuardarEx();" style="margin-right: 20px; width: 120px;"><i class="fa fa-floppy-o fa-lg" aria-hidden="true"></i> Guardar</button>
        <button type="button" id="btnImprimir" name="btnImprimir" class="btn btn-default btnLight" onclick="limpiar('todo');" style="margin-right: 20px; width: 120px;"><i class="fa fa-times fa-lg" aria-hidden="true"></i> Cancelar</button>
    </div>

</form>
@*ModalCargar*@
<div class="modal fade" id="modalcargar" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Procesando</h4>
            </div>
            <div class="modal-body" style="text-align:center">
                <p class="txt-modal">Espere un momento</p>
                <img src="~/Resources/img/spinner.gif" />
            </div>

        </div>
    </div>
</div>

@Html.Hidden("urlCalcular", Url.Action("calculo", "Excepciones"))
@Html.Hidden("urlBusqueda", Url.Action("busqueda", "Excepciones"))
@Html.Hidden("urlGuardar", Url.Action("Guardar", "Excepciones"))
@Html.Hidden("urlPagina", (object)ViewBag.pagina)
@section scriptsFooter
{
    <script src="~/Resources/js/jsExcepciones.js"></script>
    <script src="~/Resources/js/jquery.dataTables.min.js"></script>
    <script src="~/Resources/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Resources/js/dataTables.responsive.js"></script>
    @*<link href="//netdna.bootstrapcdn.com/bootstrap/3.2.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">*@
    <script src="http://malsup.github.com/jquery.form.js"></script>
}