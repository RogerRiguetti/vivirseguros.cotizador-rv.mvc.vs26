
@{
    ViewBag.Title = "Índice";
    ViewBag.Header = "Usuarios";

    Layout = "~/Views/Shared/_Layout.cshtml";

    int userId = Convert.ToInt32(this.Session["UserId"].ToString());
    var res = new Estudio.Controllers.Controllers.UserController().GetPermissions(userId);
    Estudio.Logic.Identity identity = new Estudio.Logic.Identity();
    identity = (Estudio.Logic.Identity)res.Object;

    System.Globalization.CultureInfo ciCurr = System.Globalization.CultureInfo.CurrentCulture;
}

<div class="panel panel-default">
    <div class="panel-heading">
        Búsqueda
    </div>
    <div class="panel-body">
        <div class="form-group col-lg-3 col-md-4 col-sm-6">
            <label class="form-label" for="BusquedaUsuario">Usuario</label>
            <input type="text" class="form-control" name="BusquedaUsuario" id="BusquedaUsuario" maxlength="20" onkeyup="pulsar(event)">
        </div> 
        <div class="form-group col-lg-3 col-md-4 col-sm-6">
            <label class="form-label" for="BusquedaNombres">Nombres</label>
            <input type="text" class="form-control" name="BusquedaNombres" id="BusquedaNombres" onkeypress="return soloLetras(event)" onkeyup="pulsar(event)" maxlength="50">
        </div> 
        <div class="form-group col-lg-3 col-md-4 col-sm-6">
            <label class="form-label" for="BusquedaApellidos">Apellidos</label>
            <input type="text" class="form-control" name="BusquedaApellidos" id="BusquedaApellidos" onkeypress="return soloLetras(event)" onkeyup="pulsar(event)" maxlength="60">
        </div> 

        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <a class="btn btnLight btn-md" id="btnSearch">Buscar <span class="fa fa-search"></span></a>
            <a class="btn btnDark btn-md" id="btnAdd" href="@Url.Action("Create", "User")">Agregar <span class="fa fa-plus"></span></a>
        </div>

    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading">Resultados</div>
    <div class="panel-body">
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover" id="tblCatalog" style="width:100%">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Usuario</th>
                        <th>Nombres</th>
                        <th>Apellidos</th>
                        <th>Correo</th>
                        <th>Active</th>
                        <th>Fecha Creación</th>
                        <th>Fecha Modificación</th>
                        <th>Rol</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

