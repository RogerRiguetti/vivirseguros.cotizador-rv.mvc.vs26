@* Begins Hiddens *@
@Html.Hidden("modal_delete_header", (object)ViewBag.modal_delete_header)
@Html.Hidden("modal_delete_body", (object)ViewBag.modal_delete_body)

@Html.Hidden("RedirectToConfigure", Url.Action("Configure", "User"))
@Html.Hidden("RedirectToCreate", Url.Action("Create", "User"))
@Html.Hidden("UrlSearch", Url.Action("Search", "User"))

@if(identity.UserEdit)
{
    @Html.Hidden("RedirectToEdit", Url.Action("Edit", "User"))
}

@if(identity.UserDetails)
{
    @Html.Hidden("RedirectToDetails", Url.Action("Details", "User"))
}
@if(identity.UserDelete)
{
   @Html.Hidden("url", Url.Action("Delete", "User"))
}

@* End Hiddens *@




@section scriptsFooter
{
    <script src="~/Resources/js/jquery.dataTables.min.js"></script>
    <script src="~/Resources/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Resources/js/dataTables.responsive.js"></script>
    <script src="~/Resources/js/jsUser.js"></script>
}





