@model Estudio.Repository.Core.Domain.gzUser
@{
    ViewBag.Title = "Modificar";
    ViewBag.Header = "Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .bootstrap-select .bs-ok-default::after {
        width: 0.3em;
        height: 0.6em;
        border-width: 0 0.1em 0.1em 0;
        transform: rotate(45deg) translateY(0.5rem);
    }

    .btn.dropdown-toggle:focus {
        outline: none !important;
    }

    .btn-default:hover {
        background-color: #0481A6;
        border-color: #0481A6;
        color: white;
        font-weight: bold;
    }

    .btn-default {
        background-color: #0ab6de;
        border-color: #0ab6de;
        color: white;
        font-weight: bold;
    }

    .comboMultiple > button {
        BORDER: 1px solid #ccc !important;
        BACKGROUND: WHITE !important;
        color: #555555 !important;
    }
</style>
<form id="myform">
    <div class="panel panel-default">
        <div class="panel-body">
            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 text-left">
                <div class="form-group">
                    <label class="form-label" for='txtAccount'>Usuario</label>
                    <input hide="true" id='txtId' class="form-control" type="hidden" name="txtId" value="@Model.Id" disabled="disabled" />

                    <input id='txtAccount' class='form-control' type="text" name="txtAccount" value="@Model.Account" disabled />
                </div>
            </div>

            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 text-left">
                <div class="form-group">
                    <label class="form-label" for='txtNumeroAgente'>Número Agente</label>
                    <input id='txtNumeroAgente' class='form-control' type="text" name="txtNumeroAgente" value="@Model.NumeroAgente" />
                </div>
            </div>
            <div class="clearfix"></div>
            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                <div class="form-group">
                    <label class="form-label" for="txtNombres">Nombres</label>
                    <input id='txtNombres' class="form-control" type="text" name="txtNombres" maxlength="50" value="@Model.Names" onkeypress="return soloLetras(event)" />
                </div>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                <div class="form-group">
                    <label class="form-label" for="txtApellidos">Apellidos</label>
                    <input id='txtApellidos' class="form-control" type="text" name="txtApellidos" maxlength="60" value="@Model.LastNames" onkeypress="return soloLetras(event)" />
                </div>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                <div class="form-group">
                    <label class="form-label" for="txtCorreo">Correo</label>
                    <input id='txtCorreo' class="form-control" type="text" name="txtCorreo" value="@Model.Correo" maxlength="100" />
                </div>
            </div>
            <div class="clearfix"></div>

            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                <div class="form-group">
                    <label class="form-label" for="txtPassword">Contraseña</label>
                    <input id='txtPassword' class="form-control" type="password" name="txtPassword" maxlength="20" value="@Model.Password" />
                </div>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                <div class="form-group">
                    <label class="form-label" for="txtConfirm">Confirmar Contraseña</label>
                    <input id='txtConfirm' class="form-control" type="password" name="txtConfirm" maxlength="20" value="@Model.Password" />
                    <span id="lblPasswordConfirm" style="display: none;">La contraseña no coincide con la contraseña de confirmación.</span>
                </div>
            </div>

            @*<div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <label class="form-label" for="txtRol">Rol</label>
                    <div class="form-group">
                        @Html.DropDownList("cmbxRoles", null, new { @class = "form-control" })
                    </div>
                </div>*@

            <div class="form-group col-lg-3 col-md-6 col-sm-6 col-xs-12 text-left">
                <label class="form-label" for='txtUserProfile'>Rol</label>
                <select id="cmbxRolesDetails" name="cmbxRolesDetails" style="width: 85%;" multiple data-style="bg-white rounded-pill px-4 py-3 shadow-sm "
                        class="selectpicker w-100 form-control comboMultiple" data-none-selected-text="Selecione los Roles">
                </select>
            </div>
            @if (Model.IdSupervisor != 0)
            {
                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12" id="fgSupervisor">
                    <label class="form-label" for="txtRol">Supervisor</label>
                    <div class="form-group">
                        @Html.DropDownList("cmbxSupervisores", null, new { @class = "form-control" })
                    </div>
                </div>
            }
            else
            {
                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12" id="fgSupervisor" style="display:none">
                    <label class="form-label" for="txtRol">Supervisor</label>
                    <div class="form-group">
                        @Html.DropDownList("cmbxSupervisores", null, new { @class = "form-control" })
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="row col-lg-6 col-md-6 col-sm-6 col-xs-12">
        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-6 text-left">
            <a class="btn btn-vida btn-md" href="@Url.Action("Index", "User")">Regresar <span class="fa fa-reply fa-lg"></span></a>
        </div>
        <div class="col-lg-3 col-md-4 col-sm-6 col-xs-6 text-left">
            <a class="btn btn-vida btn-md" id="btnSave">Guardar <span class="fa fa-save fa-lg"></span></a>
        </div>
    </div>
</form>

@Html.Hidden("url", Url.Action("Edit", "User"))
@Html.Hidden("id", (object)@Model.Id.ToString())
@Html.Hidden("urlIndex", Url.Action("Index", "User"))
@Html.Hidden("urlConsultarRoles", Url.Action("ConsultarRoles", "User"))
@section scriptsFooter
{
    <script src="~/Resources/js/jquery.dataTables.min.js"></script>
    <script src="~/Scripts/jquery-ui.js"></script>
    <script src="~/Resources/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Resources/js/dataTables.responsive.js"></script>
    <script src="~/Resources/js/jsUserSave.js"></script>
    <script src="~/Scripts/additional-methods.min.js"></script>

    <link href="~/Content/bootstrap-select.min.css" rel="stylesheet" />

    <script src="~/Scripts/bootstrap-select.min.js"></script>
}

