@model Estudio.Repository.Core.Domain.gzPermission
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<form id="myform">
    <div id="wrapper">
        <div id="page-wrapper">
            <div class="main-header">
                <div class="col-sm-12 col-md-12 col-lg-12 col-xs-12">
                    <h1 class="page-header">Permissions</h1>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12">
                    <div class="row">
                        <div class="col-xs-3 text-left">
                            <span class="input">
                                <input id='txtDescription' class='input_field' type="text" name="txtDescription" value="@Model.Description" />
                                <label for='txtDescription'>
                                    <span>Description</span>
                                </label>
                            </span>
                        </div>
                    </div>
                    <div class="row" style="height:60px;"></div>
                    <div class="row">
                        <div class="col-xs-6 text-left">
                            <a class="btn btn-default" href="@Url.Action("Index", "Permission")">Return <span class="glyphicon glyphicon-arrow-left"></span></a>
                        </div>
                        <div class="col-xs-6 text-right">
                            <a class="btn btn-default" id="btnSave">Save <span class="glyphicon glyphicon-floppy-saved"></span></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@Html.Hidden("url", Url.Action("Edit", "Permission"))


@section scriptsFooter
{
    <script src="~/Resources/js/jsPermissionSave.js"></script>
    <script src="https://cdn.jsdelivr.net/jquery.validation/1.15.0/additional-methods.min.js"></script>
    <script>
            // just for the demos, avoids form submit
            jQuery.validator.setDefaults({
                debug: true,
                success: "valid"
            });
            $("#myform").validate({
                errorClass: "requiredClass",
                rules: {
                    txtDescription: { required: false }
                }
            });
    </script>
}




