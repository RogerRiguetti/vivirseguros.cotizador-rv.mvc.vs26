
@{
    ViewBag.Title = "EliminarCargas";
    ViewBag.Header = "Eliminación de cargas de solicitud";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    input[type="radio"] {
        display: none;
    }

        input[type="radio"] + label span {
            display: inline-block;
            width: 27px;
            height: 27px;
            margin: -1px 4px 0 0;
            vertical-align: middle;
            background: url(/Resources/img/iconos/check.png) center no-repeat;
            cursor: pointer;
        }

        input[type="radio"]:checked + label span {
            background: url(/Resources/img/iconos/cheked.png) center no-repeat;
        }

    .modal-content {
        left: -40% !important;
        width: 180% !important;
    }
    .modalcargar {
        position: fixed;
        left: 0px;
        top: 0px;
        width: 100%;
        height: 100%;
        z-index: 9999;
        background: 50% 50% no-repeat rgb(249,249,249);
        opacity: .8;
    }

    .ImgModal{
        margin-left: 40%;
        margin-top: 15%;
    }

</style>

