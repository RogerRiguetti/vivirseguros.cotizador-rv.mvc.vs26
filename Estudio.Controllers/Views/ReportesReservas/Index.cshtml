@* Begins Hiddens *@
@Html.Hidden("urlReporteFlujosPasivos", Url.Action("ExportarFlujosPasivos", "ReportesReservas"))
@Html.Hidden("urlReporteSbs", Url.Action("ReporteSbs", "ReportesReservas"))
