
@{
    ViewBag.Header = "Reportes de Reservas";
    ViewBag.Title = "Reportes de Reservas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="panel panel-default">
    <div class="panel-body">
        <div class="form-group col-lg-3 col-md-3 col-sm-3">
            <label class="form-label" for="txtFechaPeriodo">Fecha de búsqueda:</label>
            <input type="text" class="form-control" name="txtFechaPeriodo" id="txtFechaPeriodo" placeholder="YYYYMM" maxlength="7" onKeyUp="this.value = formateafechaYearMes(this.value);">
        </div>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading">
        Generación de reportes
    </div>
    <div class="panel-body">
        <div class="btn-group">
            <button type="button" class="btn btn-default btnDark" id="btnFlujosPasivos" style="margin-right: 20px;">Flujos de Pasivos</button>
            <button type="button" class="btn btn-default btnDark" id="btnTxtFlujosPasivosNuevos" style="margin-right: 20px;">Anexo 17 - Nuevas</</button>
            <button type="button" class="btn btn-default btnDark" id="btnTxtFlujosPasivosAntiguos" style="margin-right: 20px;">Anexo 17 - Antigüas</button>
            <button type="button" class="btn btn-default btnDark" id="btnTxtFlujosPasivosMixtos" style="margin-right: 20px;">Anexo 17 - Mixtas</button>
            <button type="button" class="btn btn-default btnDark" id="btnResumenReservas" style="margin-right: 20px;">Resumen Reservas</button>
            <button type="button" class="btn btn-default btnDark" id="btnResumenAdecuacion" style="margin-right: 20px;">Resumen Adecuación</button>
            <button type="button" class="btn btn-default btnDark" id="btnBaseSbs" style="margin-right: 20px;">Base SBS</button>
        </div>
    </div>
</div>


