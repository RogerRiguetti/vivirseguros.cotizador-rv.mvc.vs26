@{
    ViewBag.Title = "IPC Mensual";
    ViewBag.Header = "Mantenedor de IPC";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    @@media(max-width: 460px) {
        .page-header {
            font-size: 2em !important;
        }
    }

    input.form-control.input-sm {
        width: 150px;
    }

</style>

<form id="myform">
    
    <div class="panel panel-default">
        <div class="panel-body">

            <div class="form-group col-xs-12 col-sm-4 col-md-4 col-lg-3" style="margin: 0px; padding: 10px 10px 20px 10px;">
                <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px;">
                    <label class="form-label" for="txtMesIPC">Período</label>
                </div>

                <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px;">
                    <div class="col-xs-5 col-sm-5 col-md-5 col-lg-5" style="padding: 0px;">
                        <input type="text" class="form-control" id="txtMesIPC" placeholder="Mes" maxlength="2" onkeypress="return soloNumeros(event);" />
                    </div>
                    <div class="col-xs-2 col-sm-2 col-md-2 col-lg-2" style="padding: 0px; text-align: center; margin-top: 5px;">
                        <label class="form-label" for="" >-</label>
                    </div>
                    <div class="col-xs-5 col-sm-5 col-md-5 col-lg-5" style="padding: 0px;">
                        <input type="text" class="form-control" id="txtAnoIPC" placeholder="Año" maxlength="4" onkeypress="return soloNumeros(event);" />
                    </div>
                </div>
            </div> <!--DIV QUE CIERRA CAMPOS PERIODO-->

            <div class="form-group col-xs-12 col-sm-4 col-md-4 col-lg-3" style="margin: 0px; padding: 10px 10px 20px 10px">
                <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px;">
                    <label class="form-label" for="txtValorIPC">IPC</label>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px;">
                    <input type="text" class="form-control" id="txtValorIPC" maxlength="20" onkeyup="this.value = validaDecimales(this.value, 2);" />
                </div>
            </div> <!--DIV QUE CIERRA CAMPO IPC-->

            <div class="form-group col-xs-12 col-sm-4 col-md-4 col-lg-3" style="margin: 0px; padding: 10px 10px 20px 10px">
                <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12" style="padding: 0px;">
                    <label class="form-label" for="txtValorTMM">Variación IPC</label>
                </div>
                <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 input-group" style="padding: 0px;">
                    <input type="text" class="form-control" id="txtCodigo" placeholder="Valor" style="display:  none;" />
                    <input type="text" class="form-control" id="txtValorTMM" maxlength="20" onkeyup="this.value = validaDecimales(this.value, 2);" />
                    <span class="input-group-addon"><i class="fa fa-percent" aria-hidden="true"></i></span>
                </div>
            </div> <!--DIV QUE CIERRA CAMPO VARIACION IPC-->

            <div class="col-xs-12 col-sm-12 col-md-12 col-lg-9" style="padding: 7.5px;">
                <div class="panel panel-default">
                    <div class="panel-body">
                        <div class="table-responsive" style="padding: 10px;">
                            <table id="tblIPC" class="table table-striped table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th style="width: 5%;">  </th>
                                        <th style="width: 32%">Periodo</th>
                                        <th style="width: 32%">Valor IPC</th>
                                        <th style="width: 31%">Variación IPC</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div> <!--DIV QUE CIERRA PANEL DE TABLA-->
            </div><!--DIV QUE CIERRA TABLA-->

        </div>
    </div> <!--DIV QUE CIERRA PANEL DE LOS CAMPOS-->

    <div class="btn-group" style="float: right">
        <button type="button" class="btn btn-default btnDark" onclick="Grabar();" style="margin-right: 20px;"><i class="fa fa-save fa-lg" aria-hidden="true"></i>&nbsp;Grabar</button>
        <button type="button" class="btn btn-default btnDark" onclick="Eliminar();" style="margin-right: 20px;"><i class="fa fa-remove fa-lg" aria-hidden="true"></i>&nbsp;Eliminar</button>
        <button type="button" class="btn btn-default btnDark" onclick="Imprimir();" style="margin-right: 20px;"><i class="fa fa-print fa-lg" aria-hidden="true"></i>&nbsp;Imprimir</button>
        <button type="button" class="btn btn-default btnLight" onclick="Limpiar()" style="margin-right: 20px;"><i class="fa fa-file fa-lg" aria-hidden="true"></i>&nbsp;Limpiar</button>
        <button type="button" class="btn btn-default btnGreen" onclick="Salir();" style="margin-right: 20px;"><img class="btnIcon" src="/Resources/img/salir.png">&nbsp;Salir</button>
    </div>

</form>

@* Begins Hiddens *@
@Html.Hidden("urlCargarTabla", Url.Action("CargarTabla", "MantenedorIPC"))
@Html.Hidden("urlConsulta", Url.Action("Consulta", "MantenedorIPC"))
@Html.Hidden("urlGrabar", Url.Action("GrabarMantenedorIPC", "MantenedorIPC"))
@Html.Hidden("urlEliminar", Url.Action("EliminarMantenedorIPC", "MantenedorIPC"))
@Html.Hidden("urlReporte", Url.Action("Reporte", "MantenedorIPC"))
@Html.Hidden("urlSalir", Url.Action("Index", "Estudio"))

@section scriptsFooter
{
    <script src="~/Resources/js/jquery.dataTables.min.js"></script>
    <script src="~/Resources/js/dataTables.bootstrap.min.js"></script>
    <script src="~/Resources/js/dataTables.responsive.js"></script>
    <script src="~/Resources/js/jsMantenedorIPC.js"></script>

}